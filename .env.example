# Backend
BACKEND_PORT=8000
OPENAI_API_KEY=
# Supabase: Project Settings -> Database -> Connection string -> Session pooler (works with Render, IPv4-compatible)
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:5432/postgres
CORS_ORIGINS=["http://localhost:5173"]
# Supabase: Project Settings -> API -> JWT Secret (used to verify access tokens issued by Supabase Auth)
SUPABASE_JWT_SECRET=
# Supabase: Project Settings -> API -> Project URL / anon public key (used by AuthService to call Supabase Auth)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Frontend
VITE_API_URL=http://localhost:8000
# Supabase: Project Settings -> API -> Project URL / publishable key (used by the Supabase JS SDK)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
