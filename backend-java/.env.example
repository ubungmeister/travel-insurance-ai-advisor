# Spring Boot backend environment — copy to .env and fill in real values.

# Supabase Postgres (JDBC). Get host/user/password from
# Supabase dashboard -> Project Settings -> Database -> Connection string (JDBC / Session pooler).
SPRING_DATASOURCE_URL=jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.PROJECT_REF
SPRING_DATASOURCE_PASSWORD=YOUR_DB_PASSWORD

# Supabase Auth (JWT verification + Auth REST API).
# Project Settings -> API -> Project URL / publishable key.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# HTTP port the backend listens on.
BACKEND_PORT=8000
